<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_project_task_form_inherit_construction" model="ir.ui.view">
            <field name="name">project.task.form.inherit.construction_plan_import</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/notebook" position="inside">
                    <page string="Construction">
                        <group>
                            <group>
                                <field name="x_task_key"/>
                                <field name="x_revision"/>
                                <field name="x_project_code"/>
                                <field name="x_block_code"/>
                                <field name="x_wbs_code"/>
                            </group>
                            <group>
                                <field name="x_start_date"/>
                                <field name="date_deadline"/>
                                <field name="x_assigned_role"/>
                            </group>
                        </group>
                        <group>
                            <field name="x_requires_approval"/>
                            <field name="x_drawing_refs"/>
                            <field name="x_confidence"/>
                        </group>
                        <group>
                            <field name="x_predecessor_task_keys" readonly="1"/>
                            <field name="x_predecessor_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="x_rationale"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_project_task_tree_inherit_construction" model="ir.ui.view">
            <field name="name">project.task.tree.inherit.construction_plan_import</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_tree2"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="x_task_key" optional="hide"/>
                    <field name="x_wbs_code" optional="hide"/>
                    <field name="x_block_code" optional="hide"/>
                    <field name="x_assigned_role" optional="hide"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
