<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_construction_task_material_line_tree" model="ir.ui.view">
            <field name="name">construction.task.material.line.tree</field>
            <field name="model">construction.task.material.line</field>
            <field name="arch" type="xml">
                <list>
                    <header>
                        <button name="action_create_purchase_order" type="object" string="Create Purchase Orders" class="btn-primary"/>
                    </header>
                    <field name="project_id"/>
                    <field name="task_id"/>
                    <field name="product_id"/>
                    <field name="has_vendor" widget="boolean_toggle" optional="show"/>
                    <field name="qty_planned"/>
                    <field name="uom_id"/>
                    <field name="waste_factor"/>
                    <field name="procurement_method"/>
                    <field name="confidence"/>
                </list>
            </field>
        </record>

        <record id="view_construction_task_material_line_form" model="ir.ui.view">
            <field name="name">construction.task.material.line.form</field>
            <field name="model">construction.task.material.line</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="task_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="qty_planned"/>
                            <field name="uom_id"/>
                            <field name="waste_factor"/>
                            <field name="procurement_method"/>
                            <field name="confidence"/>
                        </group>
                        <group>
                            <field name="notes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_construction_task_material_line" model="ir.actions.act_window">
            <field name="name">Planned Materials</field>
            <field name="res_model">construction.task.material.line</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
