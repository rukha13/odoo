<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_project_project_form_inherit_construction" model="ir.ui.view">
            <field name="name">project.project.form.inherit.construction_plan_import</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/notebook" position="inside">
                    <page string="Construction">
                        <group>
                            <field name="x_project_code"/>
                            <field name="x_revision"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
