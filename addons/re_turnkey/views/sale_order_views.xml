<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_sale_order_form_re_unit" model="ir.ui.view">
            <field name="name">sale.order.form.re.unit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="re_unit_id" />
                </xpath>
            </field>
        </record>

        <record id="view_sale_order_tree_re_unit" model="ir.ui.view">
            <field name="name">sale.order.tree.re.unit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="re_unit_id" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
