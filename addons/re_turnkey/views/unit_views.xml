<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_re_unit_list" model="ir.ui.view">
            <field name="name">re.unit.list</field>
            <field name="model">re.unit</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="building_id" />
                    <field name="project_id" />
                    <field name="floor" />
                    <field name="unit_type" />
                    <field name="area_sqm" />
                    <field name="list_price" />
                    <field name="state" />
                    <field name="partner_id" />
                </list>
            </field>
        </record>

        <record id="view_re_unit_form" model="ir.ui.view">
            <field name="name">re.unit.form</field>
            <field name="model">re.unit</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,available,reserved,sold,handover_ready,handed_over" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="building_id" />
                                <field name="project_id" readonly="1" />
                                <field name="floor" />
                            </group>
                            <group>
                                <field name="unit_type" />
                                <field name="area_sqm" />
                                <field name="list_price" />
                                <field name="currency_id" invisible="1" />
                            </group>
                        </group>
                        <group string="Customer">
                            <field name="partner_id" />
                            <field name="sale_order_id" />
                            <field name="opportunity_id" />
                        </group>
                        <notebook>
                            <page string="Handovers">
                                <field name="handover_ids" context="{'default_unit_id': id}">
                                    <list>
                                        <field name="name" />
                                        <field name="handover_date" />
                                        <field name="state" />
                                        <field name="partner_id" />
                                    </list>
                                </field>
                            </page>
                            <page string="Tasks">
                                <field name="task_ids" context="{'default_re_unit_id': id}">
                                    <list>
                                        <field name="name" />
                                        <field name="project_id" />
                                        <field name="stage_id" />
                                        <field name="date_deadline" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_re_unit_search" model="ir.ui.view">
            <field name="name">re.unit.search</field>
            <field name="model">re.unit</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="building_id" />
                    <field name="project_id" />
                    <field name="partner_id" />
                </search>
            </field>
        </record>
    </data>
</odoo>
