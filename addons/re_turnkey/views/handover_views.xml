<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_re_handover_list" model="ir.ui.view">
            <field name="name">re.handover.list</field>
            <field name="model">re.handover</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="unit_id" />
                    <field name="project_id" />
                    <field name="partner_id" />
                    <field name="handover_date" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="view_re_handover_form" model="ir.ui.view">
            <field name="name">re.handover.form</field>
            <field name="model">re.handover</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_schedule" type="object" string="Schedule" class="btn-primary" modifiers="{'invisible': [['state','!=','draft']]}" />
                        <button name="action_mark_done" type="object" string="Mark Done" class="btn-primary" modifiers="{'invisible': [['state','!=','scheduled']]}" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,done,cancelled" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="unit_id" />
                                <field name="project_id" readonly="1" />
                            </group>
                            <group>
                                <field name="partner_id" />
                                <field name="sale_order_id" />
                                <field name="handover_date" />
                            </group>
                        </group>
                        <group>
                            <field name="notes" nolabel="1" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_re_handover_search" model="ir.ui.view">
            <field name="name">re.handover.search</field>
            <field name="model">re.handover</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="unit_id" />
                    <field name="project_id" />
                    <field name="partner_id" />
                </search>
            </field>
        </record>
    </data>
</odoo>
