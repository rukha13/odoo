<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_re_building" model="ir.actions.act_window">
            <field name="name">Buildings</field>
            <field name="res_model">re.building</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first building
                </p>
            </field>
        </record>

        <record id="action_re_unit" model="ir.actions.act_window">
            <field name="name">Units</field>
            <field name="res_model">re.unit</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first unit
                </p>
            </field>
        </record>

        <record id="action_re_handover" model="ir.actions.act_window">
            <field name="name">Handovers</field>
            <field name="res_model">re.handover</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Schedule your first handover
                </p>
            </field>
        </record>

        <menuitem id="menu_re_turnkey_root" name="Turnkey" sequence="10" />
        <menuitem id="menu_re_buildings" name="Buildings" parent="menu_re_turnkey_root" action="action_re_building" sequence="10" />
        <menuitem id="menu_re_units" name="Units" parent="menu_re_turnkey_root" action="action_re_unit" sequence="20" />
        <menuitem id="menu_re_handovers" name="Handovers" parent="menu_re_turnkey_root" action="action_re_handover" sequence="30" />
    </data>
</odoo>
