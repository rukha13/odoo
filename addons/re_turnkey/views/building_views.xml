<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_re_building_list" model="ir.ui.view">
            <field name="name">re.building.list</field>
            <field name="model">re.building</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="code" />
                    <field name="project_id" />
                    <field name="address" />
                    <field name="unit_count" />
                </list>
            </field>
        </record>

        <record id="view_re_building_form" model="ir.ui.view">
            <field name="name">re.building.form</field>
            <field name="model">re.building</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code" />
                                <field name="project_id" />
                            </group>
                            <group>
                                <field name="address" />
                                <field name="unit_count" readonly="1" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Units">
                                <field name="unit_ids" context="{'default_building_id': id}">
                                    <list editable="bottom">
                                        <field name="name" />
                                        <field name="floor" />
                                        <field name="unit_type" />
                                        <field name="area_sqm" />
                                        <field name="list_price" />
                                        <field name="state" />
                                        <field name="partner_id" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
