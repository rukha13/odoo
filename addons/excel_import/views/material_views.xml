<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="excel_material_list" model="ir.ui.view">
        <field name="name">excel.material.list</field>
        <field name="model">excel.material</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="%(action_excel_import_wizard)d" string="Import Excel" type="action" class="btn-primary"/>
                </header>
                <field name="number"/>
                <field name="name"/>
                <field name="unit"/>
                <field name="quantity"/>
                <field name="price"/>
                <field name="total_price"/>
                <field name="entity_number"/>
            </list>
        </field>
    </record>

    <record id="excel_material_form" model="ir.ui.view">
        <field name="name">excel.material.form</field>
        <field name="model">excel.material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="name"/>
                            <field name="unit"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="total_price"/>
                            <field name="entity_number"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_excel_material" model="ir.actions.act_window">
        <field name="name">Materials</field>
        <field name="res_model">excel.material</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
